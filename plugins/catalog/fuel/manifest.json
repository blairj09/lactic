{
  "apiVersion": 1,
  "id": "fuel",
  "name": "Fuel Reminder",
  "version": "1.0.0",
  "description": "Reminds you to eat every 20 minutes on longer rides, with a carb amount that goes up when you ride harder.",
  "author": "Lactic",
  "homepage": "https://github.com/blairj09/lactic/tree/modular-ui/plugins/catalog/fuel",
  "main": "main.js",
  "permissions": { "read": ["live"] },
  "publishes": [
    { "id": "due", "label": "Time to eat", "kind": "choice", "choices": ["no", "now"] },
    { "id": "carbs", "label": "Carbs suggested so far", "unit": "g", "kind": "number" }
  ],
  "contributes": {
    "fields": [{ "id": "next", "title": "Fuel", "entry": "field" }]
  }
}
