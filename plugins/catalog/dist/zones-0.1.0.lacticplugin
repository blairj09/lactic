{"lacticplugin":1,"manifest":{"apiVersion":1,"id":"zones","name":"Zones","version":"0.1.0","description":"Live ride fields for time in heart rate and power zones, and your power over the last 5 minutes.","homepage":"https://github.com/blairj09/lactic/tree/modular-ui/plugins/catalog/zones","main":"main.js","permissions":{"read":["live"]},"contributes":{"fields":[{"id":"hr-zones","title":"HR zones","entry":"hrZones"},{"id":"power-zones","title":"Power zones","entry":"powerZones"},{"id":"power-trend","title":"Power, last 5 min","entry":"powerTrend"}]}},"main":"\"use strict\";\n(() => {\n  // ../plugins/sdk/src/index.ts\n  function definePlugin(handlers) {\n    globalThis.lactic.register(handlers);\n    return handlers;\n  }\n\n  // ../plugins/catalog/zones/src/plugin.ts\n  function stepper() {\n    let last = null;\n    return (now) => {\n      const dt = last === null ? 0 : Math.min(5, Math.max(0, now - last));\n      last = now;\n      return dt;\n    };\n  }\n  var minutes = (s) => `${Math.floor(s / 60)} min`;\n  function zoneField(input, zone, time, step, needs) {\n    const dt = step(input.now);\n    if (zone == null) return { tree: { type: \"stack\", children: [{ type: \"field\", label: \"\", value: \"–\", sub: needs, tone: \"muted\" }, { type: \"bars\", values: time, labels: time.map((_, i) => `Z${i + 1}`), palette: \"zones\" }] } };\n    const z = Math.min(time.length, Math.max(1, Math.round(zone)));\n    time[z - 1] += dt;\n    return {\n      tree: {\n        type: \"stack\",\n        children: [\n          { type: \"field\", label: \"\", value: `Z${z}`, unit: minutes(time[z - 1]) },\n          { type: \"bars\", values: time.map((s) => Math.round(s)), labels: time.map((_, i) => `Z${i + 1}`), palette: \"zones\" }\n        ]\n      }\n    };\n  }\n  var hrTime = [0, 0, 0, 0, 0];\n  var powerTime = [0, 0, 0, 0, 0, 0, 0];\n  var hrStep = stepper();\n  var powerStep = stepper();\n  var recent = [];\n  definePlugin({\n    hrZones: (input) => zoneField(input, input.metrics[\"heart_rate.zone\"], hrTime, hrStep, \"needs HR and threshold HR\"),\n    powerZones: (input) => zoneField(input, input.metrics[\"power.zone\"], powerTime, powerStep, \"needs power and FTP\"),\n    powerTrend(input) {\n      recent.push(input.metrics[\"power\"] ?? null);\n      if (recent.length > 300) recent.shift();\n      const nums = recent.filter((v) => v !== null);\n      const avg = nums.length ? Math.round(nums.reduce((a, b) => a + b, 0) / nums.length) : null;\n      const line = recent.filter((_, i) => i % 5 === 0);\n      return {\n        tree: {\n          type: \"stack\",\n          children: [\n            { type: \"field\", label: \"\", value: avg === null ? \"–\" : String(avg), unit: \"W avg\" },\n            { type: \"sparkline\", values: line }\n          ]\n        }\n      };\n    }\n  });\n})();\n"}