{"lacticplugin":1,"manifest":{"apiVersion":1,"id":"decoupling","name":"Aerobic Decoupling","version":"1.0.0","description":"How far your heart rate drifts up against your power over a steady ride. Under 5% is a sign of good aerobic fitness.","author":"Lactic","homepage":"https://github.com/blairj09/lactic/tree/modular-ui/plugins/catalog/decoupling","main":"main.js","permissions":{"read":["live","rides"]},"publishes":[{"id":"drift_live","label":"Drift so far","unit":"%","kind":"number"},{"id":"drift","label":"Decoupling","unit":"%","kind":"number"}],"contributes":{"fields":[{"id":"drift","title":"HR drift","entry":"field"}],"analyses":[{"id":"ride","title":"Aerobic decoupling","entry":"analyze"}]}},"main":"(() => {\n  // ../plugins/sdk/src/index.ts\n  function definePlugin(handlers) {\n    globalThis.lactic.register(handlers);\n    return handlers;\n  }\n\n  // ../plugins/catalog/decoupling/src/plugin.ts\n  var WARMUP = 600;\n  var MIN_STEADY = 1200;\n  var tone = (drift) => drift < 5 ? \"good\" : drift < 8 ? \"warn\" : \"bad\";\n  function decoupling(power2, hr2) {\n    const half = Math.floor(power2.length / 2);\n    if (half < 60) return null;\n    const ratio = (from, to) => {\n      let p = 0;\n      let h = 0;\n      for (let i = from; i < to; i++) {\n        p += power2[i];\n        h += hr2[i];\n      }\n      return h > 0 ? p / h : 0;\n    };\n    const first = ratio(0, half);\n    const second = ratio(half, half * 2);\n    if (!first) return null;\n    return { first, second, drift: (first - second) / first * 100 };\n  }\n  var power = [];\n  var hr = [];\n  var lastElapsed = 0;\n  definePlugin({\n    field(input) {\n      const elapsed = input.metrics[\"ride.elapsed\"] ?? 0;\n      if (elapsed < lastElapsed) power = hr = [];\n      lastElapsed = elapsed;\n      const p = input.metrics[\"power\"];\n      const h = input.metrics[\"heart_rate\"];\n      if (elapsed >= WARMUP && p != null && h) {\n        power.push(p);\n        hr.push(h);\n      }\n      if (power.length < MIN_STEADY) {\n        const wait = elapsed < WARMUP ? WARMUP - elapsed + MIN_STEADY : MIN_STEADY - power.length;\n        return { tree: { type: \"field\", label: \"HR drift\", value: \"–\", unit: \"%\", sub: h ? `in ${Math.ceil(wait / 60)} min` : \"needs heart rate\", tone: \"muted\" } };\n      }\n      const d = decoupling(power, hr);\n      const tree = { type: \"field\", label: \"HR drift\", value: d.drift.toFixed(1), unit: \"%\", sub: d.drift < 5 ? \"holding steady\" : \"heart rate creeping up\", tone: tone(d.drift) };\n      return { tree, metrics: { drift_live: Math.round(d.drift * 10) / 10 } };\n    },\n    analyze(input) {\n      const ride = input.ride;\n      if (!ride?.watts || !ride.heartRate) return { tree: { type: \"text\", text: \"Needs a ride with power and heart rate.\", tone: \"muted\" } };\n      const step = ride.stepSeconds;\n      const p = [];\n      const h = [];\n      for (let i = Math.ceil(WARMUP / step); i < ride.watts.length; i++) {\n        const w = ride.watts[i];\n        const b = ride.heartRate[i];\n        if (w != null && b) {\n          p.push(w);\n          h.push(b);\n        }\n      }\n      if (p.length * step < MIN_STEADY) return { tree: { type: \"text\", text: `Needs at least ${(WARMUP + MIN_STEADY) / 60} minutes with power and heart rate.`, tone: \"muted\" } };\n      const d = decoupling(p, h);\n      const avg = p.reduce((a, b) => a + b, 0) / p.length;\n      const np = input.metrics[\"ride.np\"];\n      const steady = np && avg ? np / avg < 1.1 : true;\n      const tree = {\n        type: \"stack\",\n        children: [\n          {\n            type: \"stack\",\n            direction: \"row\",\n            children: [\n              { type: \"stat\", label: \"Decoupling\", value: `${d.drift.toFixed(1)}%`, sub: d.drift < 5 ? \"well coupled\" : \"heart rate drifted\", tone: tone(d.drift) },\n              { type: \"stat\", label: \"First half\", value: d.first.toFixed(2), sub: \"watts per beat\" },\n              { type: \"stat\", label: \"Second half\", value: d.second.toFixed(2), sub: \"watts per beat\" }\n            ]\n          },\n          ...steady ? [] : [{ type: \"text\", text: \"Power varied a lot, so take this with a pinch of salt.\", tone: \"muted\", size: \"sm\" }]\n        ]\n      };\n      return { tree, metrics: { drift: Math.round(d.drift * 10) / 10 } };\n    }\n  });\n})();\n"}