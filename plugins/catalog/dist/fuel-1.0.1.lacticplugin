{"lacticplugin":1,"manifest":{"apiVersion":1,"id":"fuel","name":"Fuel Reminder","version":"1.0.1","description":"Reminds you to eat every 20 minutes on longer rides, with a carb amount that goes up when you ride harder.","homepage":"https://github.com/blairj09/lactic/tree/modular-ui/plugins/catalog/fuel","main":"main.js","permissions":{"read":["live"]},"publishes":[{"id":"due","label":"Time to eat","kind":"choice","choices":["no","now"]},{"id":"carbs","label":"Carbs suggested so far","unit":"g","kind":"number"}],"contributes":{"fields":[{"id":"next","title":"Fuel","entry":"field"}]}},"main":"(() => {\n  // ../plugins/sdk/src/index.ts\n  function definePlugin(handlers) {\n    globalThis.lactic.register(handlers);\n    return handlers;\n  }\n\n  // ../plugins/catalog/fuel/src/plugin.ts\n  var EVERY = 20 * 60;\n  var SHOW_FOR = 60;\n  var EASY_G_PER_HOUR = 40;\n  var HARD_G_PER_HOUR = 80;\n  var HARD_FROM = 75;\n  function clock(s) {\n    return `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, \"0\")}`;\n  }\n  var carbs = 0;\n  var lastBite = 0;\n  definePlugin({\n    field(input) {\n      const elapsed = input.metrics[\"ride.elapsed\"];\n      if (elapsed == null) return { tree: { type: \"field\", label: \"Fuel\", value: \"–\", sub: \"starts with the ride\", tone: \"muted\" } };\n      if (elapsed < lastBite) carbs = lastBite = 0;\n      const intensity = input.metrics[\"ride.intensity\"];\n      const perHour = intensity != null && intensity >= HARD_FROM ? HARD_G_PER_HOUR : EASY_G_PER_HOUR;\n      const grams = Math.round(perHour * EVERY / 3600 / 5) * 5;\n      const bite = Math.floor(elapsed / EVERY);\n      if (bite * EVERY > lastBite) {\n        lastBite = bite * EVERY;\n        carbs += grams;\n      }\n      const due = bite > 0 && elapsed - bite * EVERY < SHOW_FOR;\n      const next = (bite + 1) * EVERY - elapsed;\n      const kj = input.metrics[\"so_far.kj\"];\n      const tree = due ? { type: \"field\", label: \"Fuel\", value: \"Eat\", sub: `about ${grams} g of carbs`, tone: \"warn\" } : { type: \"field\", label: \"Fuel\", value: clock(next), sub: kj != null ? `${Math.round(kj)} kcal used` : `${grams} g next`, tone: \"default\" };\n      return { tree, metrics: { due: due ? \"now\" : \"no\", carbs } };\n    }\n  });\n})();\n"}