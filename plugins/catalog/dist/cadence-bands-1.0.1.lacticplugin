{"lacticplugin":1,"manifest":{"apiVersion":1,"id":"cadence-bands","name":"Cadence Bands","version":"1.0.1","description":"Your cadence smoothed over 30 seconds with a trend line, and how long you spent in each cadence band after the ride.","homepage":"https://github.com/blairj09/lactic/tree/modular-ui/plugins/catalog/cadence-bands","main":"main.js","permissions":{"read":["live","rides"]},"publishes":[{"id":"smooth","label":"Cadence, 30 s","unit":"rpm","kind":"number"},{"id":"coasting","label":"Time coasting","unit":"s","kind":"number"}],"contributes":{"fields":[{"id":"smooth","title":"Cadence 30 s","entry":"field"}],"analyses":[{"id":"ride","title":"Cadence bands","entry":"analyze"}]}},"main":"(() => {\n  // ../plugins/sdk/src/index.ts\n  function definePlugin(handlers) {\n    globalThis.lactic.register(handlers);\n    return handlers;\n  }\n\n  // ../plugins/catalog/cadence-bands/src/plugin.ts\n  var SMOOTH = 30;\n  var TREND_EVERY = 10;\n  var LOW = 70;\n  var HIGH = 110;\n  var BANDS = [\n    [1, 70, \"<70\", \"under 70 rpm\"],\n    [70, 85, \"70s\", \"70–84 rpm\"],\n    [85, 95, \"85+\", \"85–94 rpm\"],\n    [95, 105, \"95+\", \"95–104 rpm\"],\n    [105, 1e3, \"105+\", \"105 rpm and up\"]\n  ];\n  var clock = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, \"0\")}`;\n  var recent = [];\n  var trend = [];\n  var ticks = 0;\n  var lastElapsed = 0;\n  definePlugin({\n    field(input) {\n      const elapsed = input.metrics[\"ride.elapsed\"] ?? 0;\n      if (elapsed < lastElapsed) recent = trend = [];\n      lastElapsed = elapsed;\n      const rpm = input.metrics[\"cadence\"];\n      if (rpm != null) {\n        recent.push(rpm);\n        if (recent.length > SMOOTH) recent.shift();\n      }\n      if (!recent.length) return { tree: { type: \"field\", label: \"Cadence 30 s\", value: \"–\", unit: \"rpm\", sub: \"needs cadence\", tone: \"muted\" } };\n      const avg = recent.reduce((a, b) => a + b, 0) / recent.length;\n      if (++ticks % TREND_EVERY === 0) {\n        trend.push(Math.round(avg));\n        if (trend.length > 120) trend.shift();\n      }\n      const tone = avg < LOW || avg > HIGH ? \"warn\" : \"default\";\n      const tree = {\n        type: \"stack\",\n        children: [\n          { type: \"field\", label: \"Cadence 30 s\", value: String(Math.round(avg)), unit: \"rpm\", tone },\n          { type: \"sparkline\", values: trend }\n        ]\n      };\n      return { tree, metrics: { smooth: Math.round(avg) } };\n    },\n    analyze(input) {\n      const ride = input.ride;\n      if (!ride?.cadence) return { tree: { type: \"text\", text: \"Needs a ride with cadence.\", tone: \"muted\" } };\n      const step = ride.stepSeconds;\n      const seconds = BANDS.map(() => 0);\n      let coasting = 0;\n      for (const c of ride.cadence) {\n        if (c == null) continue;\n        if (c < 1) coasting += step;\n        else BANDS.forEach(([from, to], i) => c >= from && c < to && (seconds[i] += step));\n      }\n      const pedalling = seconds.reduce((a, b) => a + b, 0);\n      if (!pedalling) return { tree: { type: \"text\", text: \"No pedalling recorded.\", tone: \"muted\" } };\n      const tree = {\n        type: \"stack\",\n        children: [\n          { type: \"bars\", values: seconds.map((s) => Math.round(s / 60)), labels: BANDS.map((b) => b[2]) },\n          {\n            type: \"table\",\n            columns: [\"Cadence\", \"Time\", \"Share\"],\n            align: [\"left\", \"right\", \"right\"],\n            rows: [\n              ...BANDS.map((b, i) => [b[3], clock(seconds[i]), `${Math.round(seconds[i] / pedalling * 100)}%`]),\n              [\"Coasting\", clock(coasting), \"\"]\n            ]\n          }\n        ]\n      };\n      return { tree, metrics: { coasting } };\n    }\n  });\n})();\n"}