{"lacticplugin":1,"manifest":{"apiVersion":1,"id":"w-prime","name":"W′ Balance","version":"1.0.0","description":"How much of your hard-effort energy (W′) is left, live and over each ride. Uses your FTP as critical power.","author":"Lactic","homepage":"https://github.com/blairj09/lactic/tree/modular-ui/plugins/catalog/w-prime","main":"main.js","permissions":{"read":["live","rides","profile"]},"publishes":[{"id":"balance","label":"W′ left","unit":"J","kind":"number"},{"id":"percent","label":"W′ left","unit":"%","kind":"number"},{"id":"lowest","label":"Lowest W′ in the ride","unit":"%","kind":"number"}],"contributes":{"fields":[{"id":"balance","title":"W′ balance","entry":"field"}],"analyses":[{"id":"ride","title":"W′ balance","entry":"analyze"}]}},"main":"(() => {\n  // ../plugins/sdk/src/index.ts\n  function definePlugin(handlers) {\n    globalThis.lactic.register(handlers);\n    return handlers;\n  }\n\n  // ../plugins/catalog/w-prime/src/plugin.ts\n  var W_PRIME = 2e4;\n  var CP_OVERRIDE = null;\n  function step(balance2, power, cp, dt) {\n    if (power > cp) return Math.max(0, balance2 - (power - cp) * dt);\n    return Math.min(W_PRIME, balance2 + (W_PRIME - balance2) * (cp - power) * dt / W_PRIME);\n  }\n  function tone(share) {\n    return share < 0.25 ? \"bad\" : share < 0.5 ? \"warn\" : \"good\";\n  }\n  var criticalPower = (input) => CP_OVERRIDE ?? input.metrics[\"profile.ftp\"] ?? null;\n  var balance = W_PRIME;\n  var lastTick = null;\n  var lastElapsed = 0;\n  definePlugin({\n    field(input) {\n      const cp = criticalPower(input);\n      const power = input.metrics[\"power\"];\n      const elapsed = input.metrics[\"ride.elapsed\"] ?? 0;\n      if (elapsed < lastElapsed) balance = W_PRIME;\n      lastElapsed = elapsed;\n      const dt = lastTick === null ? 0 : Math.min(5, Math.max(0, input.now - lastTick));\n      lastTick = input.now;\n      if (!cp) return { tree: { type: \"field\", label: \"W′ balance\", value: \"–\", sub: \"needs your FTP\", tone: \"muted\" } };\n      if (power != null) balance = step(balance, power, cp, dt);\n      const share = balance / W_PRIME;\n      const tree = {\n        type: \"stack\",\n        children: [\n          { type: \"field\", label: \"W′ balance\", value: (balance / 1e3).toFixed(1), unit: \"kJ\", sub: `${Math.round(share * 100)}% left`, tone: tone(share) },\n          // A gauge: Lactic draws the first chart in a ride field under the number.\n          { type: \"meter\", value: share, tone: tone(share) }\n        ]\n      };\n      return { tree, metrics: { balance: Math.round(balance), percent: Math.round(share * 100) } };\n    },\n    // Runs once on a saved ride: the balance over the whole ride, with the low stretches marked.\n    analyze(input) {\n      const ride = input.ride;\n      const cp = criticalPower(input);\n      if (!ride?.watts || !cp) return { tree: { type: \"text\", text: \"Needs a ride with power and your FTP.\", tone: \"muted\" } };\n      const dt = ride.stepSeconds;\n      let bal = W_PRIME;\n      let lowest = W_PRIME;\n      const series = [];\n      for (const w of ride.watts) {\n        bal = step(bal, w ?? 0, cp, dt);\n        lowest = Math.min(lowest, bal);\n        series.push(bal);\n      }\n      const every = Math.max(1, Math.ceil(series.length / 2e3));\n      const x = [];\n      const y = [];\n      for (let i = 0; i < series.length; i += every) {\n        x.push(i * dt);\n        y.push(Math.round(series[i] / 100) / 10);\n      }\n      const marks = [];\n      let start = null;\n      series.forEach((b, i) => {\n        if (b < W_PRIME * 0.25 && start === null) start = i;\n        if ((b >= W_PRIME * 0.25 || i === series.length - 1) && start !== null) {\n          marks.push({ from: start * dt, to: i * dt, tone: \"bad\" });\n          start = null;\n        }\n      });\n      const low = lowest / W_PRIME;\n      return {\n        tree: {\n          type: \"stack\",\n          children: [\n            {\n              type: \"stack\",\n              direction: \"row\",\n              children: [\n                { type: \"stat\", label: \"Lowest\", value: `${Math.round(low * 100)}%`, sub: `${(lowest / 1e3).toFixed(1)} of ${W_PRIME / 1e3} kJ`, tone: tone(low) },\n                { type: \"stat\", label: \"Critical power\", value: `${Math.round(cp)} W`, sub: CP_OVERRIDE ? \"set in the plugin\" : \"your FTP\" }\n              ]\n            },\n            { type: \"profile\", x, y, xUnit: \"s\", yUnit: \"kJ\", marks: marks.slice(0, 40) }\n          ]\n        },\n        metrics: { lowest: Math.round(low * 100) }\n      };\n    }\n  });\n})();\n"}