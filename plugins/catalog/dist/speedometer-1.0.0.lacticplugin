{"lacticplugin":1,"manifest":{"apiVersion":1,"id":"speedometer","name":"Speedometer","version":"1.0.0","description":"The speed your power would carry you on a flat road, on a dial like a speedometer.","homepage":"https://github.com/blairj09/lactic/tree/main/plugins/catalog/speedometer","main":"main.js","permissions":{"read":["live","profile"]},"publishes":[{"id":"speed","label":"Road speed","unit":"km/h","kind":"number"}],"contributes":{"fields":[{"id":"speed","title":"Road speed","entry":"speed"}]}},"main":"(() => {\n  // ../plugins/sdk/src/index.ts\n  function definePlugin(handlers) {\n    globalThis.lactic.register(handlers);\n    return handlers;\n  }\n\n  // ../plugins/catalog/speedometer/src/plugin.ts\n  var CRR = 5e-3;\n  var CDA = 0.32;\n  var RHO = 1.225;\n  var G = 9.81;\n  var DRIVETRAIN = 0.976;\n  var BIKE_KG = 9;\n  function flatSpeed(watts, kg) {\n    if (watts <= 0) return 0;\n    const p = watts * DRIVETRAIN;\n    const roll = CRR * kg * G;\n    const air = 0.5 * RHO * CDA;\n    let v = 10;\n    for (let i = 0; i < 30; i++) {\n      const f = roll * v + air * v * v * v - p;\n      const df = roll + 3 * air * v * v;\n      const next = v - f / df;\n      if (Math.abs(next - v) < 1e-6) return next;\n      v = Math.max(0.1, next);\n    }\n    return v;\n  }\n  definePlugin({\n    speed(input) {\n      const watts = input.metrics[\"power.3s\"] ?? input.metrics.power;\n      const weight = input.metrics[\"profile.weight\"] ?? 75;\n      const kmh = watts == null ? 0 : flatSpeed(watts, weight + BIKE_KG) * 3.6;\n      return {\n        tree: {\n          type: \"gauge\",\n          value: kmh,\n          min: 0,\n          max: 60,\n          unit: \"km/h\",\n          decimals: 1,\n          zones: [{ to: 25 }, { to: 40 }, { to: 60 }],\n          ticks: 10,\n          needle: true\n        },\n        metrics: { speed: Math.round(kmh * 10) / 10 }\n      };\n    }\n  });\n})();\n"}