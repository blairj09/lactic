{"lacticplugin":1,"manifest":{"apiVersion":1,"id":"best-efforts","name":"Best Efforts","version":"1.0.1","description":"Your best 5-minute power so far during a ride, and your best 5 seconds to 60 minutes after it.","homepage":"https://github.com/blairj09/lactic/tree/modular-ui/plugins/catalog/best-efforts","main":"main.js","permissions":{"read":["live","rides","profile"]},"publishes":[{"id":"best_5min_live","label":"Best 5 min so far","unit":"W","kind":"number"},{"id":"best_1min","label":"Best 1 min","unit":"W","kind":"number"},{"id":"best_5min","label":"Best 5 min","unit":"W","kind":"number"},{"id":"best_20min","label":"Best 20 min","unit":"W","kind":"number"}],"contributes":{"fields":[{"id":"best-5min","title":"Best 5 min","entry":"field"}],"analyses":[{"id":"ride","title":"Best efforts","entry":"analyze"}]}},"main":"(() => {\n  // ../plugins/sdk/src/index.ts\n  function definePlugin(handlers) {\n    globalThis.lactic.register(handlers);\n    return handlers;\n  }\n\n  // ../plugins/catalog/best-efforts/src/plugin.ts\n  var DURATIONS = [\n    [5, \"5 s\"],\n    [60, \"1 min\"],\n    [300, \"5 min\"],\n    [1200, \"20 min\"],\n    [3600, \"60 min\"]\n  ];\n  function bestAverage(watts, n) {\n    if (n < 1 || watts.length < n) return null;\n    let sum2 = 0;\n    for (let i = 0; i < n; i++) sum2 += watts[i] ?? 0;\n    let best2 = sum2;\n    for (let i = n; i < watts.length; i++) {\n      sum2 += (watts[i] ?? 0) - (watts[i - n] ?? 0);\n      if (sum2 > best2) best2 = sum2;\n    }\n    return best2 / n;\n  }\n  var WINDOW = 300;\n  var ring = new Array(WINDOW).fill(0);\n  var filled = 0;\n  var pos = 0;\n  var sum = 0;\n  var best = null;\n  var lastElapsed = 0;\n  function reset() {\n    ring.fill(0);\n    filled = pos = sum = 0;\n    best = null;\n  }\n  definePlugin({\n    field(input) {\n      const elapsed = input.metrics[\"ride.elapsed\"] ?? 0;\n      if (elapsed < lastElapsed) reset();\n      lastElapsed = elapsed;\n      const power = input.metrics[\"power\"];\n      if (power != null) {\n        sum += power - ring[pos];\n        ring[pos] = power;\n        pos = (pos + 1) % WINDOW;\n        filled = Math.min(WINDOW, filled + 1);\n        if (filled === WINDOW) best = Math.max(best ?? 0, sum / WINDOW);\n      }\n      if (best === null) {\n        const left = WINDOW - filled;\n        return { tree: { type: \"field\", label: \"Best 5 min\", value: \"–\", unit: \"W\", sub: power == null ? \"needs power\" : `in ${Math.ceil(left / 60)} min`, tone: \"muted\" } };\n      }\n      const now = sum / WINDOW;\n      const tree = { type: \"field\", label: \"Best 5 min\", value: String(Math.round(best)), unit: \"W\", sub: `last 5 min ${Math.round(now)} W`, tone: now >= best - 0.5 ? \"good\" : \"default\" };\n      return { tree, metrics: { best_5min_live: Math.round(best) } };\n    },\n    analyze(input) {\n      const ride = input.ride;\n      if (!ride?.watts) return { tree: { type: \"text\", text: \"Needs a ride with power.\", tone: \"muted\" } };\n      const ftp = input.metrics[\"profile.ftp\"];\n      const kg = input.metrics[\"profile.weight\"];\n      const rows = [];\n      const found = {};\n      for (const [seconds, label] of DURATIONS) {\n        const avg = bestAverage(ride.watts, Math.round(seconds / ride.stepSeconds));\n        if (avg === null) continue;\n        found[seconds] = Math.round(avg);\n        rows.push([label, `${Math.round(avg)} W`, kg ? (avg / kg).toFixed(2) : \"–\", ftp ? `${Math.round(avg / ftp * 100)}%` : \"–\"]);\n      }\n      if (!rows.length) return { tree: { type: \"text\", text: \"The ride is too short.\", tone: \"muted\" } };\n      return {\n        tree: { type: \"table\", columns: [\"Time\", \"Power\", \"W/kg\", \"% FTP\"], align: [\"left\", \"right\", \"right\", \"right\"], rows },\n        metrics: {\n          ...found[60] !== void 0 ? { best_1min: found[60] } : {},\n          ...found[300] !== void 0 ? { best_5min: found[300] } : {},\n          ...found[1200] !== void 0 ? { best_20min: found[1200] } : {}\n        }\n      };\n    }\n  });\n})();\n"}