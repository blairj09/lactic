{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lactic",
  "version": "0.1.2",
  "identifier": "fit.lactic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lactic",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "deb", "appimage"],
    "category": "Sports",
    "copyright": "Copyright (c) 2026 James Blair",
    "license": "MIT",
    "shortDescription": "Open-source cycling coach",
    "longDescription": "Plans, workouts with your smart trainer, recovery and an AI coach you bring yourself. Your data stays on your computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
