{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lactic",
  "version": "0.1.5",
  "identifier": "fit.lactic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lactic",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://tile.openstreetmap.org",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: ipc: asset: http: https: ws:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "deb", "appimage"],
    "category": "Sports",
    "copyright": "Copyright (c) 2026 James Blair",
    "license": "MIT",
    "shortDescription": "Open-source cycling coach",
    "longDescription": "Plans, workouts with your smart trainer, recovery and an AI coach you bring yourself. Your data stays on your computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "PXC4RTM468",
      "frameworks": ["CoreBluetooth", "HealthKit", "AVFoundation", "UserNotifications", "WidgetKit", "WatchConnectivity"]
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNDhGMURFQTc0MjMyOEIKUldTTE1rS24zdkZJNjVJQ3ZRaURIb0Q2d0p3empqTlhZRTV6VTZTNG5xakI1dTF5VGdsODFxQVEK",
      "endpoints": ["https://github.com/blairj09/lactic/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
